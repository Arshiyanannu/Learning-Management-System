# System Runtime Port Configuration
PORT=5000

# MongoDB Connection String Protocol Gateway
# Replace with your local database string or MongoDB Atlas connection link
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name

# JSON Web Token Cryptographic Keys
# Use a strong, random character string to sign application session tokens securely
JWT_SECRET=your_jwt_encryption_secret_key_here
JWT_EXPIRES_IN=7d